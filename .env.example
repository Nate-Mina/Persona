# Sabrina persona game — local configuration
# Copy to .env and adjust if needed. Defaults work out of the box.

# LLM (Ollama on your 6700XT)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT=120

# Speech-to-text
STT_MODEL=base

# Text-to-speech / voice cloning (Coqui XTTS v2)
# Set TTS_DEVICE=cuda ONLY if you installed a ROCm build of torch for the 6700XT.
TTS_DEVICE=cpu
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# Persona sampling
TEMPERATURE=0.85
TOP_P=0.9

# Web search for true-crime / psych / medical facts
SEARCH_ENABLED=true
SEARCH_RESULTS=5
